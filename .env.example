# Copy this file to .env before running the app (it is ignored by Git; never commit the real one).

# Secret used to sign login tokens. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required when NODE_ENV=production; the server refuses to start without it.
JWT_SECRET=replace-this-with-a-long-random-secret

# Port for the Express API (and the built frontend when it is served in production).
PORT=4000

# Optional. SQLite file location. Defaults to server/data/kanban.sqlite when omitted.
DB_FILE=./server/data/kanban.sqlite

# Optional. Set to "production" on a hosted deployment.
NODE_ENV=development

# Optional. Set to "true" to create the demo users and boards on startup when the database is empty.
# Handy for a hosted demo whose disk starts empty. Leave "false" for real data.
AUTO_SEED=false

# Optional. Set to 1 when running behind a reverse proxy (Render, Railway, Fly, nginx) so the
# login rate limiter sees each visitor's real IP address.
TRUST_PROXY=0
